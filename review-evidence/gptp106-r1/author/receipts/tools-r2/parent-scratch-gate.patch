+//! The PHC's rate against the fabric clock over the next `cycles`, in ppm.
+double GmStepHarness::phc_ppm_over(uint64_t cycles) {
+    const uint64_t c0 = cyc_;
+    const uint64_t p0 = phc_ns();
+    run_cycles(cycles);
+    const double ideal = double(cyc_ - c0) * double(kPhcTickNs);
+    return (double(phc_ns() - p0) - ideal) / ideal * 1e6;
+}
+
+//! FPGA-gPTP #107 scratch gate (D1 = C): a takeover from a grandmaster
+//! +100 ppm and then -100 ppm from this station's oscillator. Each is a
+//! better grandmaster, phase-continuous with the domain's time, which the
+//! peer's media follows; this station follows it for 6 s. Then it falls
+//! silent (its Pdelay answers continue): the 375 ms Sync receipt timeout
+//! makes this station grandmaster, whose time base runs on its oscillator,
+//! and the peer's media follows this station from its first Sync on. Across
+//! the takeover: no PHC step, tu set for the 0.25 s holdover (a quarter
+//! tick in this model, Milan v1.2 B.1.1), no media unlock and no lost
+//! samples (B.1.2): the listener stays locked, every PDU is presented once
+//! in order at one offset, nothing is refused or slipped, and the talker
+//! keeps its cadence with no MEDIA_RESET.
+void GmStepHarness::check_takeovers() {
+    uint16_t seq = 0x7600;
+    uint64_t id = kGmC;
+    //! check_slew_connection leaves the origins on this station's own PHC,
+    //! and check_coincident_restart's settime trials moved that PHC: the
+    //! grandmasters here are independent timelines again, each starting at
+    //! this station's time
+    slew_origin_override_ = false;
+    slew_offset_ns_ = 0;
+    for (const double ppm : {100.0, -100.0}) {
+        char tag[96];
+        char n[192];
+        snprintf(tag, sizeof tag, "107 takeover from %+.0f ppm", ppm);
+        // a better grandmaster at `ppm`, its time the domain's time now
+        const uint64_t c0 = cyc_;
+        gm_drift_ = {ppm, c0, static_cast<int64_t>(phc_ns() - c0 * kPhcTickNs - gm_epoch_)};
+        media_epoch_ = gm_epoch_;
+        media_drift_ = gm_drift_;
+        gm_id_ = id++;
+        gm_priority_ = static_cast<uint8_t>(gm_priority_ - 5);
+        gm_on_ = true;
+        next_announce_ = cyc_;
+        next_sync_ = cyc_ + kSyncPeriodCyc / 2;
+        const RenderCounts follow0 = render_counts();
+        const size_t follow_sent0 = sent_.size();
+        run_cycles(6 * kClkHz);
+        const double before = phc_ppm_over(kClkHz / 2);
+        const RenderGrade fg = grade_presentation(follow_sent0, sent_.size());
+        snprintf(n, sizeof n, "%s: the follow", tag);
+        report_presentation(n, fg);
+        const RenderCounts follow1 = render_counts();
+        printf("107: %s: following, the PHC runs %+.3f ppm; the render stage refused %u, slipped %u\n",
+               tag, before, follow1.refused - follow0.refused, follow1.slips - follow0.slips);
+        snprintf(n, sizeof n, "%s: this station follows the grandmaster within 1 ppm", tag);
+        check_.that(n, before > ppm - 1.0 && before < ppm + 1.0);
+        snprintf(n, sizeof n, "%s: the published grandmaster is the peer's", tag);
+        check_.hex(n, (uint64_t(read(0x628)) << 32) | read(0x624), gm_id_);
+        // snapshots, then silence
+        const auto avb0 = counters(seq++, 0x0009);
+        const auto sout0 = counters(seq++, 0x0006);
+        sin0_accepts_.first = accepts_.size();
+        const auto sin0 = counters(seq++, 0x0005);
+        sin0_accepts_.second = accepts_.size();
+        const RenderCounts render0 = render_counts();
+        const size_t sent0 = sent_.size();
+        const size_t talker0 = talker_.size();
+        trace_ = Trace{};
+        trace_.tu_prev = dut_->rootp->milan_datapath__DOT__clkv_tu_w;
+        snprintf(n, sizeof n, "%s: tu clear before the takeover", tag);
+        check_.dec(n, trace_.tu_prev, 0);
+        trace_gm_ = kThisClock;
+        gm_on_ = false;
+        const uint64_t silent = cyc_;
+        while (!trace_.identity_cyc && cyc_ < silent + kClkHz) tick();
+        snprintf(n, sizeof n, "%s: this station is grandmaster within 375 ms of the last Sync", tag);
+        check_.that(n, trace_.identity_cyc != 0 &&
+                       trace_.identity_cyc - silent <= kClkHz * 375 / 1000 + kSyncPeriodCyc + kClkHz / 100);
+        // the peer hears this station's first Sync and follows it
+        media_switch_cyc_ = cyc_ + kClkHz / 1000;
+        run_cycles(kClkHz / 2);
+        const double after = phc_ppm_over(kClkHz / 2);
+        printf("107: %s: grandmaster after %llu cycles of silence; the PHC then runs %+.3f ppm\n",
+               tag, static_cast<unsigned long long>(trace_.identity_cyc - silent), after);
+        snprintf(n, sizeof n, "%s: as grandmaster the PHC runs on this oscillator, within 0.2 ppm", tag);
+        check_.that(n, after > -0.2 && after < 0.2);
+        snprintf(n, sizeof n, "%s: no PHC step across the takeover", tag);
+        check_.that(n, trace_.step_pulses == 0 && trace_.steps == 0);
+        snprintf(n, sizeof n, "%s: asCapable held every cycle", tag);
+        check_.dec(n, trace_.incapable_cycles, 0);
+        // tu: Milan v1.2 B.1.1, from the commit that names this station
+        snprintf(n, sizeof n, "%s: tu set in the first cycle the bank names this station", tag);
+        check_.dec(n, trace_.tu_at_identity, 1);
+        const uint64_t held = trace_.tu_fall_cyc > trace_.identity_cyc
+                            ? trace_.tu_fall_cyc - trace_.identity_cyc : 0;
+        printf("107: %s: tu held %llu cycles (quarter tick %llu), %llu episodes\n", tag,
+               static_cast<unsigned long long>(held), static_cast<unsigned long long>(kQtickCyc),
+               static_cast<unsigned long long>(trace_.tu_rises));
+        snprintf(n, sizeof n, "%s: tu held at least the 0.25 s holdover", tag);
+        check_.that(n, held >= kQtickCyc);
+        snprintf(n, sizeof n, "%s: tu cleared within the holdover's bound", tag);
+        check_.that(n, held <= 3 * kQtickCyc);
+        snprintf(n, sizeof n, "%s: one tu episode", tag);
+        check_.dec(n, trace_.tu_rises, 1);
+        size_t wrong = 0, in_hold = 0, after_hold = 0;
+        for (size_t i = talker0; i < talker_.size(); ++i) {
+            const TxPdu& q = talker_[i];
+            const bool h = q.cyc > trace_.identity_cyc + kWireSettleCyc
+                        && q.cyc + kWireSettleCyc < trace_.tu_fall_cyc;
+            const bool a = q.cyc > trace_.tu_fall_cyc + kWireSettleCyc;
+            if (!h && !a) continue;
+            in_hold += h;
+            after_hold += a;
+            wrong += q.tu != h;
+        }
+        snprintf(n, sizeof n, "%s: talker PDUs graded inside and after the hold", tag);
+        check_.that(n, in_hold > 100 && after_hold > 100);
+        snprintf(n, sizeof n, "%s: every talker PDU carries the verdict of its instant", tag);
+        check_.dec(n, wrong, 0);
+        // media: no unlock, no lost samples
+        const auto avb1 = counters(seq++, 0x0009);
+        const auto sout1 = counters(seq++, 0x0006);
+        sin1_accepts_.first = accepts_.size();
+        //! a GET_COUNTERS that gets no answer in its window is asked again
+        //! (MEDIA_UNLOCKED counts from reset, so a later answer still
+        //! covers the takeover); each retry is printed
+        std::vector<uint8_t> sin1;
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+            const size_t aecp0 = tx_frames_.size();
+            sin1 = counters(seq++, 0x0005);
+            if (counter_word(sin1, 32) != 0) break;
+            size_t aecp_tx = 0;
+            for (size_t i = aecp0; i < tx_frames_.size(); ++i)
+                aecp_tx += tx_frames_[i].size() > 37 && be(tx_frames_[i], 12, 2) == 0x22F0 &&
+                           tx_frames_[i][14] == 0xFB;
+            printf("107: %s: Stream Input GET_COUNTERS attempt %u got no answer (%zu AECP frames sent "
+                   "by this station meanwhile); asking again\n", tag, attempt + 1, aecp_tx);
+        }
+        sin1_accepts_.second = accepts_.size();
+        snprintf(n, sizeof n, "%s: one GPTP_GM_CHANGED", tag);
+        check_.dec(n, counter_word(avb1, 5) - counter_word(avb0, 5), 1);
+        snprintf(n, sizeof n, "%s: no MEDIA_RESET", tag);
+        check_.dec(n, counter_word(sout1, 2) - counter_word(sout0, 2), 0);
+        snprintf(n, sizeof n, "%s: no outgoing mr change", tag);
+        check_.dec(n, mr_toggles_since(talker0), 0);
+        printf("107: %s: the listener and the talker across the takeover\n", tag);
+        grade_the_licence(talker0, sin0, sin1);
+        const RenderGrade g = grade_presentation(sent0, sent_.size());
+        snprintf(n, sizeof n, "%s: across the takeover", tag);
+        report_presentation(n, g);
+        const RenderCounts render1 = render_counts();
+        snprintf(n, sizeof n, "%s: PDUs graded across the takeover", tag);
+        check_.that(n, g.graded > 100);
+        snprintf(n, sizeof n, "%s: every PDU's six events presented once, in order (no lost samples)", tag);
+        check_.dec(n, g.graded - g.presented + g.partial + g.disorder, 0);
+        snprintf(n, sizeof n, "%s: the render stage refused nothing", tag);
+        check_.dec(n, render1.refused - render0.refused, 0);
+        snprintf(n, sizeof n, "%s: the render stage slipped nothing", tag);
+        check_.dec(n, render1.slips - render0.slips, 0);
+        snprintf(n, sizeof n, "%s: every PDU keeps one offset across the takeover", tag);
+        check_.that(n, g.offset_hi - g.offset_lo <= kOffsetSpreadCyc);
+    }
+}
