diff --git a/tb/verilator/engine/p106_mutants.py b/tb/verilator/engine/p106_mutants.py
new file mode 100644
index 0000000..95c7c16
--- /dev/null
+++ b/tb/verilator/engine/p106_mutants.py
@@ -0,0 +1,55 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""The #106 controls of the engine mutation arm (`mutants.py`).
+
+FPGA-gPTP #106: a master announcement must reach the wire after the
+announce receipt timeout instant, even when an Announce is already queued
+behind the expiry, and on regaining the grandmaster role the Announces go
+out at once and then 1 s apart (802.1AS-2011 Figure 10-15). BECOME arms no
+Announce beat: SELF, where it ends, continues into ANNTX, which sends the
+first Announce in the same handler and arms the cadence from it. Each
+control here lists, after its issue number, every named check it must
+fail. `mutants.py` runs them with the rest of the arm.
+
+The table lives in its own module so that the arm stays under the parent
+repository's module length ratchet. It is data only.
+"""
+
+from receipt_mutants import GENERATOR
+
+#: SELF's tail, which continues into ANNTX since #106
+SELF_TAIL = ("    p.emit(\"COMMIT\")\n"
+             "    p.emit(\"BR\", label=LB[\"ANNTX\"])\n")
+#: BECOME's Sync arm, behind which 1616fc8f also armed the Announce beat
+BECOME_SYNC = ("    p.emit(\"WRST\", ra=RT, imm=RG_TMR | 1, fmt=FMT_Q)"
+               "  # sync now\n")
+#: the checks the deferred first Announce fails
+INSTANT = ("#106 3.0 s, a clock after the tick: a master Announce on the wire"
+           " after the instant")
+TIE = "#106 3.00006 s, the lab's tie: a master Announce on the wire after the instant"
+NEAR = "#106 3.001 s: a master Announce on the wire after the instant"
+AT_ONCE = "#106 regain: the first master Announce leaves at once"
+RACE = ("#106 regain race: one master Announce leaves before the better one"
+        " is taken")
+CADENCE = ("#106 regain: four more master Announces, each 1 s after the one"
+           " before")
+
+#: (name, file under hdl/, pattern, replacement, the checks it must fail);
+#: a replacement of None makes the pattern a list of pairs
+P106_MUTATIONS = [
+    # the defect #106 repairs: the first Announce waits 2 ms for a beat, so
+    # an Announce queued behind the role change disarms it first
+    ("the first master Announce waits for a beat", GENERATOR,
+     [(SELF_TAIL, "    p.emit(\"COMMIT\")\n    p.emit(\"END\")\n"),
+      (BECOME_SYNC,
+       BECOME_SYNC + "    p.emit(\"MOVE\", rd=RT, ra=0, imm=2)\n"
+                     "    p.emit(\"WRST\", ra=RT, imm=RG_TMR | 3, fmt=FMT_Q)\n")],
+     None,
+     f"{INSTANT} | {TIE} | {NEAR} | {AT_ONCE} | {RACE}"),
+    # the first Announce leaves at once but arms nothing, so no cadence
+    # follows it
+    ("the first master Announce starts no cadence", GENERATOR,
+     SELF_TAIL,
+     SELF_TAIL.replace("label=LB[\"ANNTX\"]", "label=LB[\"ANNTX\"] + 2"),
+     CADENCE),
+]
diff --git a/tb/verilator/engine/p107_mutants.py b/tb/verilator/engine/p107_mutants.py
new file mode 100644
index 0000000..2eb3a51
--- /dev/null
+++ b/tb/verilator/engine/p107_mutants.py
@@ -0,0 +1,99 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""The #107 controls of the engine mutation arm (`mutants.py`).
+
+FPGA-gPTP #107: this plane follows grandmasters across 802.1AS-2020
+B.1.1's range, and a mastership runs on this oscillator (10.1.2.1,
+10.2.4.14). BECOME's PHC word-3 write carries rate 0 in its low word, which
+the engine always applies, and the integrator in its high word, which is
+the frequency change scaledLastGmFreqChange sends (11.4.4.3.9). Each
+control here lists, after its issue number, every named check it must
+fail. `mutants.py` runs them with the rest of the arm.
+
+The table lives in its own module so that the arm stays under the parent
+repository's module length ratchet. It is data only.
+"""
+
+from p100_mutants import ENGINE, TLV_DLT
+from receipt_mutants import GENERATOR
+
+#: BECOME's word-3 operand: the integrator moved to the high word
+BECOME_SHL = ("    p.emit(\"ALU\", rd=RT, ra=RT, rb=0, cnd=ALU_SHL, imm=32)\n")
+#: the engine's word-3 rate write
+WORD3 = ("                phc_addend_we_o <= 1'b1;\n"
+         "                phc_addend_o    <= st_wdata_w[31:0];\n"
+         "                phc_slew_left_r   <= 2'd0;\n")
+#: mastership clears the slave rate seen
+UNSEEN = "      else if (tlv_become_w) slave_rate_seen_r <= 1'b0;\n"
+#: the trim limit, which is the follow range against this oscillator
+RATE = "RATE_PPM_C = 200                # the rate envelope"
+#: one trim unit in the TLV's 2^41 scale
+TLV_K = "      ((64'(CLK_HZ_P) << 33) + 64'd500_000_000)"
+
+TAKEOVER = ("#107 takeover: one rate write, this oscillator's within one trim"
+            " unit")
+OSC = "slew: mastership runs on this oscillator"
+SETTLED_RATE = "#100 TLV settled: BECOME writes rate 0, this oscillator"
+IDLE_RATE = "slew: idle timeout writes only mastership's rate 0"
+FREQ = ": scaledLastGmFreqChange is rate 0 less the estimate"
+SETTLED = "#100 TLV settled"
+SLEWING = "#100 TLV slewing"
+UNFOLLOWED = "#107 TLV unfollowed"
+TLV61 = ": scaledLastGmFreqChange is the change of the time base"
+PLUS10 = "#107 TLV after a grandmaster +10 ppm"
+MINUS10 = "#107 TLV after a grandmaster -10 ppm"
+FOLLOW = ": the trim settles within 0.2 ppm of it"
+NEAR = ": its offset stays within 1 us"
+
+#: (name, file under hdl/, pattern, replacement, the checks it must fail)
+P107_MUTATIONS = [
+    # ---- #107: the rate of a mastership -----------------------------------
+    # the defect #107 repairs: BECOME as 1616fc8f had it, the time base
+    # keeping the slave's estimate, wound or not
+    ("a mastership keeps the slave's rate", GENERATOR,
+     BECOME_SHL,
+     "    p.emit(\"ALU\", rd=RT, ra=R0, rb=RT, cnd=ALU_SUB)\n",
+     f"{TAKEOVER} | {OSC} | {SETTLED_RATE}"),
+    # the 1616fc8f engine: word 3 applied only while a slew was active
+    ("word 3 applies only during a slew", ENGINE,
+     WORD3,
+     "                if (phc_slew_active_o) begin\n"
+     "                  phc_addend_we_o <= 1'b1;\n"
+     "                  phc_addend_o    <= st_wdata_w[31:0];\n"
+     "                end\n"
+     "                phc_slew_left_r   <= 2'd0;\n",
+     f"{SETTLED_RATE} | {IDLE_RATE}"
+     f" | {UNFOLLOWED}: BECOME writes rate 0, and only it"),
+    # ---- #107: scaledLastGmFreqChange -------------------------------------
+    ("scaledLastGmFreqChange has its sign inverted", ENGINE,
+     TLV_DLT,
+     TLV_DLT.replace("25'(st_wdata_w[63:32])",
+                     "25'(-$signed(st_wdata_w[63:32]))"),
+     f"{SETTLED}{FREQ} | {SLEWING}{FREQ} | {PLUS10}{TLV61}"
+     f" | {MINUS10}{TLV61}"),
+    # the trim the PHC kept, proportional term and all, not the estimate
+    ("scaledLastGmFreqChange is the last trim's", ENGINE,
+     TLV_DLT,
+     TLV_DLT.replace("25'(st_wdata_w[63:32])", "25'(-phc_addend_o)"),
+     f"{SETTLED}{FREQ} | {SLEWING}{FREQ}"),
+    # a quarter of the change, which the qual's 50 % grading must refuse
+    ("scaledLastGmFreqChange is scaled by 2^39", ENGINE,
+     TLV_K,
+     TLV_K.replace("<< 33", "<< 31"),
+     f"{SETTLED}{FREQ} | {PLUS10}{TLV61} | {MINUS10}{TLV61}"),
+    # a mastership with no slave rate since the last one reports the stale
+    # estimate, though the time base never left this oscillator
+    ("a mastership leaves the slave rate seen", ENGINE,
+     UNSEEN,
+     "",
+     f"{UNFOLLOWED}{FREQ}"),
+    # ---- #107: the follow range (phase 59) --------------------------------
+    # a trim short of 802.1AS-2020 B.1.1's two 100 ppm LocalClocks
+    ("the trim stops short of a grandmaster 100 ppm away", GENERATOR,
+     RATE,
+     RATE.replace("= 200 ", "= 99  "),
+     "#107 a grandmaster +100 ppm" + FOLLOW
+     + " | #107 a grandmaster +100 ppm" + NEAR
+     + " | #107 a grandmaster -100 ppm" + FOLLOW
+     + " | #107 a grandmaster -100 ppm" + NEAR),
+]
diff --git a/tb/verilator/engine/sim_main.cpp b/tb/verilator/engine/sim_main.cpp
index bb4785e..8f518b2 100644
--- a/tb/verilator/engine/sim_main.cpp
+++ b/tb/verilator/engine/sim_main.cpp
@@ -247,8 +247,9 @@
 // 52      #100: the Follow_Up information TLV of each mastership
 //         (802.1AS-2011 10.2.8.2.1 j) to l), 11.4.4.3): gmTimeBaseIndicator
 //         counts masterships, lastGmPhaseChange is the last slave offset,
-//         scaledLastGmFreqChange the kept trim less the rate estimate, after
-//         a lock on a master 100 ppm fast
+//         scaledLastGmFreqChange rate 0 less the rate estimate (#107), after
+//         a lock on a master 100 ppm fast; zero for a grandmaster lost
+//         before any pair
 // 53      #100: the announce receipt watch from the received interval
 //         (10.3.9.1): logMessageInterval 1 ages at 6 s, -1 at 1.5 s
 // 54      #100: Announces exactly 3.0 s apart age the port, whatever the
@@ -259,6 +260,27 @@
 //         each is a lost response, and the fifth clears asCapable
 // 56      #100: every Announce carries the image's clockAccuracy: 0x22 by
 //         default, 0xFE in the fourth pass's image
+// 57      #106: a better grandmaster announces 3.000 s to 3.010 s apart, at
+//         several phases against the millisecond tick: in every gap the
+//         port is aged and this plane's master Announce is on the wire after
+//         the instant, before the next Announce re-elects the grandmaster
+//         (Milan v1.2 Table 4.2, 802.1AS-2011 Figures 10-13 and 10-15)
+// 58      #106: on regaining mastership from a grandmaster turned worse, the
+//         first master Announce leaves within 1 ms, then four more each 1 s
+//         after the one before; with a better Announce 1 ms behind the worse
+//         one, the master Announce still leaves first
+// 59      #107: grandmasters at +10, -10, +100 and -100 ppm against this
+//         plane's oscillator, each from mastership: the mean trim of the
+//         last 10 s settles within 0.2 ppm of the grandmaster's rate and the
+//         offset stays within 1 us (802.1AS-2020 B.1.1: two LocalClocks each
+//         within 100 ppm of TAI)
+// 60      #107: a grandmaster +60 ppm jumps 90 us and leaves two pairs later:
